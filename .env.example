# Choose ONE provider. Leave the other blank.

# OpenAI-compatible (OpenAI, Azure OpenAI, local proxies, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: override data directory inside the container/host
# DATA_DIR=/app/data

# Offline demo (no API key): deterministic fill from the experience bank
# MOCK_LLM=1

# PDF compile via the Compose `tex` sidecar (default in docker-compose.yml).
# Leave unset / empty to skip PDF and keep .tex only when running locally without Docker.
# TEX_COMPILE_URL=http://tex:8080/compile
